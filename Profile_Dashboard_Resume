/* modals */
function modal(html){closeModal();const d=document.createElement('div');d.className='scrim';d.innerHTML=`<div class="modal" role="dialog" aria-modal="true">${html}</div>`;d.addEventListener('mousedown',e=>{if(e.target===d)closeModal()});document.body.appendChild(d);document.body.classList.add('noscroll');return d.firstElementChild}
function closeModal(){$('.scrim')?.remove();document.body.classList.remove('noscroll')}
addEventListener('keydown',e=>{if(e.key==='Escape')closeModal()});
function arm(b){if(b.classList.contains('armed'))return true;b.classList.add('armed');const old=b.innerHTML;b.textContent='Tap again to confirm';setTimeout(()=>{if(b.isConnected){b.classList.remove('armed');b.innerHTML=old}},3000);return false}

