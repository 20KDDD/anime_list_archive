 addDropPaste(m,setImg);
 m.addEventListener('input',e=>{const k=e.target.dataset.mk;if(k)tmp[k]=e.target.value});
 m.addEventListener('change',e=>{if(e.target.id==='mi'&&e.target.files[0])setImg(e.target.files[0])});
 const finish=()=>{save();closeModal();rerenderSec(s);updateHero()};
 const q=m.querySelector('#q');if(q){const run=async()=>{const v=q.value.trim(),qr=m.querySelector('#qr');if(!v)return;qr.innerHTML='<p class="msg">Searching…</p>';
  try{const r=await fetch('https://graphql.anilist.co',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({query:'query($s:String){Page(perPage:9){media(search:$s,type:ANIME,sort:SEARCH_MATCH){id seasonYear title{english romaji} coverImage{large}}}}',variables:{s:v}})});if(!r.ok)throw 0;const res=(await r.json()).data.Page.media;
   if(!res.length){qr.innerHTML='<p class="msg">No matches. Try another spelling.</p>';return}
   qr.innerHTML=res.map((a,i)=>`<button data-pick="${i}"><img src="${esc(a.coverImage.large)}" alt=""><span>${esc(a.title.english||a.title.romaji)}${a.seasonYear?` (${a.seasonYear})`:''}</span></button>`).join('');
   qr.onclick=e=>{const b=e.target.closest('[data-pick]');if(!b)return;const a=res[+b.dataset.pick];tmp.title=a.title.english||a.title.romaji;tmp.img=a.coverImage.large;m.querySelector('#m-title').value=tmp.title;drawPrev();qr.innerHTML=''}}
  catch(e){qr.innerHTML='<p class="msg">Poster search can\'t reach AniList from here. It works once the page is hosted on its own, like on GitHub Pages. You can upload a poster instead.</p>'}};
  m.querySelector('#qb').onclick=run;q.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();run()}});setTimeout(()=>q.focus(),30)}
 else setTimeout(()=>m.querySelector('#m-title')?.focus(),30);
 m.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;
  if(b.id==='mclr'){tmp.img='';drawPrev()}
  else if(b.id==='msave'){if(!String(tmp.title||'').trim()){m.querySelector('#merr').textContent=`Add a ${fields[0].l.toLowerCase()} first.`;return}if(orig)arr[idx]=tmp;else arr.push(tmp);finish()}
  else if(b.id==='mdel'){if(!arm(b))return;arr.splice(idx,1);finish()}
  else if(b.id==='mup'){[arr[idx-1],arr[idx]]=[arr[idx],arr[idx-1]];finish()}
  else if(b.id==='mdn'){[arr[idx+1],arr[idx]]=[arr[idx],arr[idx+1]];finish()}
  else if(b.id==='mpro'){arr.splice(idx,1);getList(s,L.to).push(tmp);finish();toast(`Moved to ${target.l.toLowerCase()}`)}})}

function openEntry(id){const orig=S.diary.find(x=>x.id===id);const tmp=orig?{...orig,photos:[...(orig.photos||[])]}:{id:uid(),ts:Date.now(),date:today(),title:'',mood:'',text:'',photos:[]};
 const m=modal(`<div class="mh"><h3>${orig?'Edit save file':'New save file'}</h3><button class="ib" data-close aria-label="Close"><span class="ms">close</span></button></div>
 <div class="fields"><div class="fld"><label for="e-date">Date</label><input type="date" id="e-date" value="${esc(tmp.date)}"></div><div class="fld"><label for="e-title">Title</label><input id="e-title" value="${esc(tmp.title)}" placeholder="Name this day"></div></div>
 <div class="fld" style="margin-top:14px"><label>Mood</label><div class="moods" id="e-moods"></div></div>
 <div class="fld" style="margin-top:14px"><label for="e-text">Entry</label><textarea id="e-text" class="etext" rows="8" style="min-height:9em" placeholder="What happened today?">${esc(tmp.text)}</textarea></div>
 <div class="fld" style="margin-top:14px"><label>Photos</label><div class="ephotos" id="e-ph"></div></div>
 <p class="err" id="merr"></p><div class="mact">${orig?'<button class="btn danger" id="edel">Delete</button>':''}<span class="sp"></span><button class="btn" data-close>Cancel</button><button class="btn pri" id="esave">Save</button></div>`);
 const drawM=()=>{m.querySelector('#e-moods').innerHTML=MOODS.map(([k,c])=>`<button type="button" class="mood${tmp.mood===k?' on':''}" data-m="${k}" style="--mc:${c}">${cap(k)}</button>`).join('')};
 const drawP=()=>{m.querySelector('#e-ph').innerHTML=tmp.photos.map((p,i)=>`<div class="ep"><img src="${esc(p)}" alt=""><button type="button" class="x" data-rp="${i}" aria-label="Remove photo"><span class="ms">close</span></button></div>`).join('')+`<label class="ep add" title="Add photos"><span class="ms">add_photo_alternate</span><input type="file" accept="image/*" multiple hidden id="e-file"></label>`};
 drawM();drawP();
 const addPhoto=async f=>{try{tmp.photos.push(await readImg(f,1400));drawP()}catch(e){toast("That file couldn't be read as an image.")}};addDropPaste(m,addPhoto);
 m.addEventListener('change',async e=>{if(e.target.id==='e-file'){for(const f of e.target.files)await addPhoto(f)}});
 const done=()=>{save();closeModal();render()};
 m.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;
  if(b.dataset.m){tmp.mood=tmp.mood===b.dataset.m?'':b.dataset.m;drawM()}
  else if(b.dataset.rp!==undefined){tmp.photos.splice(+b.dataset.rp,1);drawP()}
  else if(b.id==='edel'){if(!arm(b))return;S.diary=S.diary.filter(x=>x.id!==tmp.id);done()}
  else if(b.id==='esave'){tmp.date=m.querySelector('#e-date').value||today();tmp.title=m.querySelector('#e-title').value;tmp.text=m.querySelector('#e-text').value;
   if(!tmp.title.trim()&&!tmp.text.trim()&&!tmp.photos.length){m.querySelector('#merr').textContent='Write something or add a photo first.';return}
   if(orig)Object.assign(orig,tmp);else S.diary.push(tmp);done();if(!orig)toast('Saved. +25 XP')}});
 if(!orig)setTimeout(()=>m.querySelector('#e-title').focus(),30)}

/* backup */
function doExport(){const json=JSON.stringify(S);try{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([json],{type:'application/json'}));a.download=`player-card-backup-${today()}.json`;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove()},1000)}catch(e){}
 const m=modal(`<div class="mh"><h3>Backup</h3><button class="ib" data-close aria-label="Close"><span class="ms">close</span></button></div><p class="note" style="margin-top:0">If a file downloaded, you're set. If nothing downloaded, copy this text and save it somewhere private, like a note or a file on your computer.</p><textarea class="bk" readonly id="bk" style="margin-top:10px">${esc(json)}</textarea><p class="note">${(json.length/1048576).toFixed(1)} MB, mostly images.</p><div class="mact"><span class="sp"></span><button class="btn pri" id="bkcopy"><span class="ms">content_copy</span>Copy backup text</button></div>`);
 m.querySelector('#bkcopy').onclick=async()=>{try{await navigator.clipboard.writeText(json);toast('Backup copied')}catch(e){const t=m.querySelector('#bk');t.focus();t.select();toast('Select all and copy')}}}
function doImport(text,errEl){try{const o=JSON.parse(text);if(!o||typeof o!=='object'||!o.v||!o.theme)throw 0;S=merge(fresh(),o);save();applyTheme();render();toast('Backup loaded')}catch(e){if(errEl)errEl.textContent="That doesn't look like a Player Card backup."}}

/* events */
document.addEventListener('input',e=>{const el=e.target,ds=el.dataset;
 if(ds.h!==undefined){S.hero[ds.h]=el.value;updateHero();save();return}
 if(ds.f){const [s,k]=split(ds.f);S.f[s]??={};let v=el.value;if(ds.auto!==undefined&&v===ds.auto)v='';S.f[s][k]=v;
  if(k.endsWith('_hex')){const sw=el.closest('.sw');sw.style.background=v;sw.classList.remove('empty')}
  if(s==='profile'&&k==='birthday')rerenderSec('stars');
  if(s==='persona'&&k==='house'&&S.theme.house)applyTheme();
  updateHero();save();return}
 if(ds.ob){S.ob[ds.ob]=el.value;updateHero();if(ds.ob==='title'){const a=$('#ob .spotact');if(a&&!!el.value!==!!a.querySelector('[data-act=retire]'))rerenderObKeep(el)}save();return}
 if(ds.tl){const [s,id]=split(ds.tl);const it=getList(s,'items').find(x=>x.id===id);if(it){it.text=el.value;updateHero();save()}return}
 if(ds.rename){S.layout.titles[ds.rename]=el.value;save();return}
 if(ds.sacc){S.layout.accent[ds.sacc]=el.value;const lb=el.closest('.sacc');lb.style.background=el.value;lb.classList.remove('empty');save();return}
 if(ds.cc){S.theme.custom={...curColors(),[ds.cc]:el.value};S.theme.preset='custom';applyTheme();document.querySelectorAll('.thm').forEach(b=>b.classList.toggle('on',b.dataset.preset==='custom'));const cb=$('.thm[data-preset=custom]');if(cb)for(const[k,v]of[['tb','bg'],['tc','card'],['ta','acc'],['t2','acc2']])cb.style.setProperty('--'+k,S.theme.custom[v]);save();return}
 if(el.id==='ns-name'){$('#ns-err').textContent=''}});
function rerenderObKeep(el){const pos=el.selectionStart;rerenderOb();const n=$('#ob-title');if(n){n.focus();try{n.setSelectionRange(pos,pos)}catch(e){}}}
document.addEventListener('change',async e=>{const el=e.target;
 if(el.dataset.up&&el.files&&el.files[0]){const key=el.dataset.up,f=el.files[0];el.value='';try{
  if(key==='banner')S.hero.banner=await readImg(f,1800);else if(key==='avatar')S.hero.avatar=await readImg(f,500);else if(key==='ob')S.ob.img=await readImg(f,700);
  else if(key.startsWith('f:')){const [s,k]=split(key.slice(2));S.f[s]??={};S.f[s][k]=await readImg(f,800)}
  save();if(key.startsWith('f:'))rerenderSec(split(key.slice(2))[0]);else render();updateHero()}catch(err){toast("That file couldn't be read as an image.")}return}
 if(el.id==='housetog'){S.theme.house=el.checked;applyTheme();save();return}
 if(el.id==='impfile'&&el.files[0]){const text=await el.files[0].text();el.value='';doImport(text,$('#imp-err'))}});
document.addEventListener('dragover',e=>{if(e.target.closest('.pc.add,.addrow[data-add],.imgslot,.spotimg,.avatar,.banner'))e.preventDefault()});
document.addEventListener('drop',async e=>{const f=[...(e.dataTransfer?.files||[])].find(f=>f.type.startsWith('image/'));if(!f)return;const t=e.target.closest('[data-add],.imgslot,.spotimg,.avatar,.banner');if(!t)return;e.preventDefault();
 try{if(t.dataset.add){const [s,k]=split(t.dataset.add);openItem(s,k,null,await readImg(f,700));return}
  const inp=t.querySelector('input[data-up]');if(!inp)return;const dt=new DataTransfer();dt.items.add(f);inp.files=dt.files;inp.dispatchEvent(new Event('change',{bubbles:true}))}catch(err){toast("That file couldn't be read as an image.")}});
document.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;const ds=b.dataset;
 if('close' in ds){closeModal();return}
 if(b.closest('.modal'))return;
 if(ds.tab){page=ds.tab;render();scrollTo(0,0);return}
 if(ds.add){const [s,k]=split(ds.add);openItem(s,k);return}
 if(ds.edit){const [s,r]=split(ds.edit);const [k,id]=split(r);openItem(s,k,id);return}
 if(ds.entry){openEntry(ds.entry);return}
 if(ds.tladd){getList(ds.tladd,'items').push({id:uid(),text:'',done:false});rerenderSec(ds.tladd);save();const ts=document.querySelectorAll(`#s-${ds.tladd} textarea`);ts[ts.length-1]?.focus();return}
 if(ds.tldel){const [s,id]=split(ds.tldel);S.l[s].items=getList(s,'items').filter(x=>x.id!==id);rerenderSec(s);updateHero();save();return}
 if(ds.ck){const [s,id]=split(ds.ck);const it=getList(s,'items').find(x=>x.id===id);if(it){it.done=!it.done;rerenderSec(s);updateHero();save();if(it.done)toast('Quest complete. +20 XP')}return}
 if(ds.filt){const [s,v]=split(ds.filt);filt[s]=v;rerenderSec(s);return}
 if(ds.clr){const [s,k]=split(ds.clr);if(S.f[s])S.f[s][k]='';rerenderSec(s);updateHero();save();return}
 if(ds.obdel!==undefined){S.obHist.splice(+ds.obdel,1);rerenderOb();updateHero();save();return}
 if(ds.preset){S.theme.preset=ds.preset;applyTheme();save();render();return}
 if(ds.opt){const [g,v]=split(ds.opt);S.theme[g]=v;applyTheme();save();render();return}
 if(ds.vis){S.layout.hidden[ds.vis]=!S.layout.hidden[ds.vis];save();render();return}
 if(ds.saccclr){delete S.layout.accent[ds.saccclr];save();render();return}
 if(ds.mv){const [p,r]=split(ds.mv);const i2=r.lastIndexOf('.');const id=r.slice(0,i2),dir=+r.slice(i2+1);const o=order(p),i=o.indexOf(id),j=i+dir;if(i<0||j<0||j>=o.length)return;[o[i],o[j]]=[o[j],o[i]];S.layout.order[p]=o;save();render();return}
 if(ds.delsec){if(!arm(b))return;S.layout.custom=S.layout.custom.filter(c=>c.id!==ds.delsec);delete S.l[ds.delsec];delete S.f[ds.delsec];save();render();return}
 const act=ds.act;if(!act)return;
 if(act==='newentry')openEntry();
 else if(act==='retire'){if(S.ob.title){S.obHist.unshift({...S.ob,until:today()});S.ob={};obOpen=true;rerenderOb();updateHero();save();toast('Moved to past obsessions')}}
 else if(act==='hist'){obOpen=!obOpen;rerenderOb()}
 else if(act==='addsec'){const n=$('#ns-name').value.trim();if(!n){$('#ns-err').textContent='Give the section a name first.';return}S.layout.custom.push({id:'c'+uid(),t:n,page:$('#ns-page').value,type:$('#ns-type').value});save();const pg=$('#ns-page').value;render();toast(`Added to ${pg==='about'?'About me':'Favorites'}`)}
 else if(act==='export')doExport();
 else if(act==='imppaste'){const t=$('#imp-text').value.trim();if(!t){$('#imp-err').textContent='Paste your backup text first.';return}doImport(t,$('#imp-err'))}
 else if(act==='reset'){if(!arm(b))return;S=fresh();save();applyTheme();page='about';render();toast('Everything erased')}});

(async()=>{await load();applyTheme();render();if(!canSave)setStatus()})();
</script>
</body></html>
