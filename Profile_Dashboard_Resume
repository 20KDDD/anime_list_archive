/* ambient background */
const cv=$('#amb'),cx=cv.getContext('2d');let parts=[],raf=0;
function sizeCv(){const d=window.devicePixelRatio||1;cv.width=innerWidth*d;cv.height=innerHeight*d;cx.setTransform(d,0,0,d,0,0)}
function startAmb(){cancelAnimationFrame(raf);const mode=S.theme.amb;cx.clearRect(0,0,cv.width,cv.height);if(mode==='off'){cv.hidden=true;return}cv.hidden=false;sizeCv();
 const rm=matchMedia('(prefers-reduced-motion: reduce)').matches;const W=innerWidth,H=innerHeight;const n={fireflies:34,stars:110,petals:24,rain:80}[mode]||30;
 parts=Array.from({length:n},()=>({x:Math.random()*W,y:Math.random()*H,r:Math.random(),s:Math.random(),p:Math.random()*6.28}));
 const cs=getComputedStyle(document.documentElement),acc=cs.getPropertyValue('--acc').trim(),ink=cs.getPropertyValue('--ink').trim();
 const frame=t=>{const W=innerWidth,H=innerHeight;cx.clearRect(0,0,W,H);
  for(const q of parts){
   if(mode==='fireflies'){if(!rm){q.x+=Math.sin(t/2200+q.p)*.35;q.y-=.12+q.s*.22;if(q.y<-10){q.y=H+10;q.x=Math.random()*W}}const a=.2+.6*(.5+.5*Math.sin(t/(600+q.s*900)+q.p));const r=1.1+q.r*1.7;cx.fillStyle=acc;cx.globalAlpha=a*.16;cx.beginPath();cx.arc(q.x,q.y,r*4.5,0,6.29);cx.fill();cx.globalAlpha=a;cx.beginPath();cx.arc(q.x,q.y,r,0,6.29);cx.fill()}
   else if(mode==='stars'){const a=.12+.55*(.5+.5*Math.sin(t/(900+q.s*1400)+q.p));cx.fillStyle=q.r>.9?acc:ink;cx.globalAlpha=a;cx.beginPath();cx.arc(q.x,q.y,.5+q.r*1.1,0,6.29);cx.fill()}
   else if(mode==='petals'){if(!rm){q.y+=.35+q.s*.55;q.x+=Math.sin(t/1300+q.p)*.55;if(q.y>H+12){q.y=-12;q.x=Math.random()*W}}cx.save();cx.translate(q.x,q.y);cx.rotate(t/1600*(q.s-.5)+q.p);cx.fillStyle=acc;cx.globalAlpha=.45;cx.beginPath();cx.ellipse(0,0,4+q.r*3.5,2.2+q.r*1.6,0,0,6.29);cx.fill();cx.restore()}
   else if(mode==='rain'){if(!rm){q.y+=7+q.s*6;q.x-=1;if(q.y>H+20){q.y=-20;q.x=Math.random()*(W+100)}}cx.strokeStyle=ink;cx.globalAlpha=.13+q.r*.1;cx.lineWidth=1;cx.beginPath();cx.moveTo(q.x,q.y);cx.lineTo(q.x+1.5,q.y-(10+q.r*14));cx.stroke()}
  }cx.globalAlpha=1;if(!rm)raf=requestAnimationFrame(frame)};
 frame(performance.now())}
