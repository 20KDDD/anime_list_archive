function heroHTML(){const h=S.hero;return `<section class="hero"><div class="banner${h.banner?'':' empty'}" ${h.banner?`style="background-image:url('${esc(h.banner)}')"`:''}><label class="bbtn"><span class="ms">wallpaper</span>${h.banner?'Change banner':'Add banner'}<input type="file" accept="image/*" hidden data-up="banner"></label></div>
 <div class="herobody"><label class="avatar" title="Change your avatar">${h.avatar?`<img src="${esc(h.avatar)}" alt="Your avatar">`:'<span class="ms" style="font-size:26px">add_a_photo</span><span>Avatar</span>'}<input type="file" accept="image/*" hidden data-up="avatar"></label>
 <div class="who"><input class="hin nm" id="h-name" data-h="name" value="${esc(h.name)}" placeholder="Your name" aria-label="Your name"><input class="hin ttl" id="h-title" data-h="title" value="${esc(h.title)}" placeholder="Your title" aria-label="Your title"><div class="chips" id="chips">${chipsHTML()}</div></div>
 <div class="lv" id="lv">${lvHTML()}</div></div></section>`}
function obHTML(){const o=S.ob||{};return `<section class="sec spot" id="ob"><label class="spotimg${o.img?' has':''}" title="Add an image">${o.img?`<img src="${esc(o.img)}" alt="">`:'<span class="ms">add_photo_alternate</span><span>Image</span>'}<input type="file" accept="image/*" hidden data-up="ob"></label>
 <div class="spotbody"><div class="eyebrow"><span class="ms">local_fire_department</span>Current obsession</div>
 <div class="fld"><input class="big" id="ob-title" data-ob="title" value="${esc(o.title)}" placeholder="Anything: an anime, game, song, show" aria-label="Current obsession"></div>
 <div class="row2"><div class="fld"><label for="ob-cat">Type</label><select id="ob-cat" data-ob="cat">${OBCATS.map(c=>`<option value="${c}"${c===(o.cat||'')?' selected':''}>${c||'—'}</option>`).join('')}</select></div><div class="fld"><label for="ob-since">Since</label><input type="date" id="ob-since" data-ob="since" value="${esc(o.since)}"></div></div>
 <div class="fld"><label for="ob-why">Why I can't stop</label><textarea id="ob-why" data-ob="why" rows="2" placeholder="—">${esc(o.why)}</textarea></div>
 <div class="spotact">${o.title?'<button class="btn sm" data-act="retire"><span class="ms">archive</span>Move to past obsessions</button>':''}${S.obHist.length?`<button class="btn sm" data-act="hist"><span class="ms">history</span>${obOpen?'Hide':'Show'} past (${S.obHist.length})</button>`:''}</div>
 ${obOpen&&S.obHist.length?`<div class="hist">${S.obHist.map((x,i)=>`<div class="hrow"><span class="th">${x.img?`<img src="${esc(x.img)}" alt="">`:'<span class="ms">local_fire_department</span>'}</span><span class="rt">${esc(x.title)}<small>${[x.cat,x.since?fmtDate(x.since):'',x.until?'to '+fmtDate(x.until):''].filter(Boolean).map(esc).join(' · ')}</small></span><button class="x" data-obdel="${i}" aria-label="Remove"><span class="ms">close</span></button></div>`).join('')}</div>`:''}
 </div></section>`}
function updateHero(){const c=$('#chips');if(c)c.innerHTML=chipsHTML();const l=$('#lv');if(l)l.innerHTML=lvHTML()}

/* diary */
