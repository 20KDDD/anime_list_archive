/* storage: IndexedDB in this browser only */
function idb(){return new Promise((res,rej)=>{try{const r=indexedDB.open('player-card',1);r.onupgradeneeded=()=>r.result.createObjectStore('kv');r.onsuccess=()=>res(r.result);r.onerror=()=>rej(r.error)}catch(e){rej(e)}})}
