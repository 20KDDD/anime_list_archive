function diaryHTML(){const e=[...S.diary].sort(sortEntries);
 return `<div class="pagehead"><div><h1>Diary</h1><p>${e.length} save file${e.length===1?'':'s'}. Each one adds 25 XP.</p></div><button class="btn pri" data-act="newentry"><span class="ms">edit</span>New entry</button></div>
 ${e.length?`<div class="entries">${e.map((x,i)=>{const m=MOODS.find(k=>k[0]===x.mood);const np=(x.photos||[]).length;return `<button class="sec entry" data-entry="${x.id}">${np?`<img class="eimg" src="${esc(x.photos[0])}" alt="">`:''}<span class="einner"><span class="emeta"><span class="fileno">SAVE ${String(e.length-i).padStart(3,'0')}</span><span>${fmtDate(x.date)}</span></span><h3>${esc(x.title||'Untitled')}</h3>${x.text?`<p>${esc(x.text)}</p>`:''}<span style="display:flex;gap:8px;align-items:center">${m?`<span class="moodc" style="--mc:${m[1]}">${cap(m[0])}</span>`:''}${np>1?`<span class="note" style="margin:0">+${np-1} photo${np>2?'s':''}</span>`:''}</span></span></button>`}).join('')}</div>`
 :`<div class="sec emptyp"><span class="ms">menu_book</span><h2>Write your first save file</h2><p>Give the day a title, pick a mood, write what happened, and add photos.</p><button class="btn pri" data-act="newentry"><span class="ms">edit</span>Write an entry</button></div>`}`}

/* customize */
function customizeHTML(){const t=S.theme,cur=curColors(),house=(S.f.persona||{}).house;
 const opt=(g,label,vals)=>`<div class="optg"><span>${label}</span><div class="opts">${vals.map(([v,l])=>`<button class="chip${t[g]===v?' on':''}" data-opt="${g}.${v}">${l}</button>`).join('')}</div></div>`;
 const rows=p=>{const ids=order(p);return ids.map((id,i)=>{const d=def(id),acc=S.layout.accent[id],off=S.layout.hidden[id];return `<div class="srow${off?' off':''}"><button class="ib" data-vis="${id}" aria-label="${off?'Show':'Hide'} section" title="${off?'Show':'Hide'}"><span class="ms">${off?'visibility_off':'visibility'}</span></button><input class="sname" data-rename="${id}" value="${esc(S.layout.titles[id]||d.t)}" aria-label="Section name"><label class="sacc${acc?'':' empty'}" ${acc?`style="background:${esc(acc)}"`:''} title="Tile color"><input type="color" data-sacc="${id}" value="${esc(acc||'#888888')}" aria-label="Tile color"></label>${acc?`<button class="ib" data-saccclr="${id}" title="Use theme color" aria-label="Use theme color"><span class="ms">format_color_reset</span></button>`:''}<button class="ib" data-mv="${p}.${id}.-1" ${i===0?'disabled':''} aria-label="Move up"><span class="ms">arrow_upward</span></button><button class="ib" data-mv="${p}.${id}.1" ${i===ids.length-1?'disabled':''} aria-label="Move down"><span class="ms">arrow_downward</span></button>${d.custom?`<button class="ib" data-delsec="${id}" aria-label="Delete section"><span class="ms">delete</span></button>`:''}</div>`}).join('')};
 return `<div class="pagehead"><div><h1>Customize</h1><p>Colors, fonts, background and which sections show up.</p></div></div><div class="cz">
 <section class="sec"><h2 class="sh"><span class="ms">palette</span>Theme</h2><div class="themes">${Object.entries(PRESETS).map(([k,p])=>`<button class="thm${t.preset===k?' on':''}" data-preset="${k}" style="--tb:${p.bg};--tc:${p.card};--ta:${p.acc};--t2:${p.acc2}"><span class="tprev"><i></i><i></i><i></i></span>${p.n}</button>`).join('')}<button class="thm${t.preset==='custom'?' on':''}" data-preset="custom" style="--tb:${t.custom.bg};--tc:${t.custom.card};--ta:${t.custom.acc};--t2:${t.custom.acc2}"><span class="tprev"><i></i><i></i><i></i></span>My custom</button></div>
 <div class="custcols">${[['bg','Background'],['card','Cards'],['ink','Text'],['acc','Accent'],['acc2','Second accent']].map(([k,l])=>`<label class="cc"><input type="color" data-cc="${k}" value="${cur[k]}">${l}</label>`).join('')}</div>
 <p class="note">Changing a color saves it as your custom theme. Each section can also get its own tile color below.</p>
 <label class="tog"><input type="checkbox" id="housetog" ${t.house?'checked':''}>Use my Hogwarts house colors for accents</label>${house?'':'<p class="note">Pick your house in Personality first.</p>'}</section>
 <section class="sec"><h2 class="sh"><span class="ms">brush</span>Style</h2>${opt('font','Heading font',[['game','Game'],['clean','Clean'],['hand','Handwritten'],['pixel','Pixel']])}${opt('card','Card style',[['solid','Solid'],['glass','Frosted glass'],['outline','Ink outline']])}${opt('amb','Moving background',[['fireflies','Fireflies'],['stars','Stars'],['petals','Petals'],['rain','Rain'],['off','Off']])}</section>
 <section class="sec"><h2 class="sh"><span class="ms">dashboard_customize</span>Sections</h2><p class="hint" style="margin-top:0">Rename, hide, reorder, or give a tile its own color.</p><div class="sgrp">About me</div>${rows('about')}<div class="sgrp">Favorites</div>${rows('favs')}</section>
 <section class="sec"><h2 class="sh"><span class="ms">add_box</span>Add your own section</h2><div class="newsec"><div class="fld wide"><label for="ns-name">Name</label><input id="ns-name" placeholder="Books, Cooking, Tattoos, anything"></div><div class="fld"><label for="ns-page">Page</label><select id="ns-page"><option value="about">About me</option><option value="favs">Favorites</option></select></div><div class="fld"><label for="ns-type">Holds</label><select id="ns-type"><option value="notes">A list</option><option value="gallery">An image grid</option><option value="check">A checklist</option><option value="text">A block of text</option></select></div></div><p class="err" id="ns-err"></p><div class="brow"><button class="btn pri" data-act="addsec"><span class="ms">add</span>Add section</button></div></section>
 <section class="sec"><h2 class="sh"><span class="ms">save</span>Backup</h2><p class="hint" style="margin-top:0">Everything is saved in this browser only. Nobody who opens this page sees your data. Export a backup now and then, and keep it private.</p>
