<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><style>body{margin:0}img{max-width:100%}[hidden]{display:none!important}</style></head><body>
<title>Player Card</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Chakra+Petch:wght@500;600;700&family=Outfit:wght@400;500;600&family=Silkscreen&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..24,400,0..1,0&display=block">
<style>
:root{--bg:#0B1510;--card:#13241B;--ink:#E8F0E6;--acc:#E3C065;--acc2:#1A6B45;--on2:#FFFFFF;--onacc:#141414;
--line:color-mix(in srgb,var(--ink) 14%,var(--card));--dim:color-mix(in srgb,var(--ink) 68%,var(--bg));--faint:color-mix(in srgb,var(--ink) 40%,var(--bg));
--cardbg:var(--card);--fh:'Chakra Petch',system-ui,sans-serif;--fb:'Outfit',system-ui,sans-serif;color-scheme:dark}
[data-font=clean]{--fh:'Outfit',system-ui,sans-serif}
[data-font=hand]{--fh:'Caveat','Segoe Print',cursive}
[data-font=pixel]{--fh:'Silkscreen',ui-monospace,monospace}
[data-card=glass]{--cardbg:color-mix(in srgb,var(--card) 58%,transparent)}
[data-card=outline]{--cardbg:transparent;--line:color-mix(in srgb,var(--ink) 30%,var(--bg))}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--fb);font-size:15px;line-height:1.5;min-height:100vh}
body.noscroll{overflow:hidden}
.ms{font-family:'Material Symbols Rounded';font-weight:normal;font-style:normal;font-size:19px;line-height:1;letter-spacing:normal;text-transform:none;display:inline-block;white-space:nowrap;direction:ltr;-webkit-font-smoothing:antialiased;font-feature-settings:'liga';vertical-align:middle;flex-shrink:0}
button{font:inherit;color:inherit;cursor:pointer;background:none;border:0;padding:0}
button:focus-visible,a:focus-visible,label:focus-within{outline:2px solid var(--acc);outline-offset:2px}
input,select,textarea{font:inherit;color:var(--ink)}
::placeholder{color:var(--faint);opacity:1}
#amb{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}

.nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:color-mix(in srgb,var(--bg) 86%,transparent);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.navin{max-width:1180px;margin:0 auto;padding-inline:16px;padding-block:10px;display:flex;align-items:center;gap:14px}
.brand{font-family:var(--fh);font-weight:700;font-size:15px;color:var(--acc);border:1.5px solid var(--acc);border-radius:8px;padding:2px 7px;letter-spacing:.05em}
.tabs{display:flex;gap:4px;overflow-x:auto;scrollbar-width:none;flex:1;min-width:0}
.tabs button{display:flex;align-items:center;gap:6px;padding:7px 12px;border-radius:9px;font-size:13.5px;color:var(--dim);white-space:nowrap}
.tabs button:hover{color:var(--ink);background:var(--line)}
.tabs button.on{background:var(--acc2);color:var(--on2)}
.stat{font-size:12px;color:var(--faint);white-space:nowrap;transition:opacity .4s}
.stat.warn{color:#F0997B}
@media (max-width:620px){.tabs .ms{display:none}.tabs button{padding:7px 10px}.stat{display:none}.stat.warn{display:inline}}

.wrap{position:relative;z-index:1;max-width:1180px;margin:0 auto;padding-inline:16px;padding-block:0 64px}
.sec{background:var(--cardbg);border:1px solid var(--line);border-radius:14px;padding:14px 16px 16px}
[data-card=glass] .sec,[data-card=glass] .hero{backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
.sec[style*="--sa"]{border-color:color-mix(in srgb,var(--sa) 75%,transparent)}
.sh{display:flex;align-items:center;gap:8px;margin:0 0 12px;font-family:var(--fh);font-weight:600;font-size:13px;letter-spacing:.09em;text-transform:uppercase;color:var(--sa,var(--acc));text-wrap:balance}
.sh .ms{font-size:18px}
[data-font=hand] .sh{font-size:23px;letter-spacing:0;text-transform:none;font-weight:700}
[data-font=pixel] .sh{font-size:11.5px;letter-spacing:.03em;font-weight:400}
[data-font=clean] .sh{letter-spacing:.07em}
.hint{margin:-6px 0 12px;font-size:12.5px;color:var(--faint)}
.board{columns:330px;column-gap:14px;margin-top:14px}
.board>.sec{break-inside:avoid;-webkit-column-break-inside:avoid;margin:0 0 14px;display:block}
.pagehead{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;flex-wrap:wrap;padding-block:24px 4px}
.pagehead h1{margin:0;font-family:var(--fh);font-size:28px;font-weight:700;line-height:1.1}
[data-font=hand] .pagehead h1{font-size:38px}
[data-font=pixel] .pagehead h1{font-size:22px;font-weight:400}
.pagehead p{margin:4px 0 0;color:var(--dim);font-size:14px}

.hero{margin-top:16px;border:1px solid var(--line);border-radius:18px;overflow:hidden;background:var(--cardbg)}
.banner{position:relative;height:clamp(130px,22vw,230px);background-color:var(--acc2);background-size:cover;background-position:center}
.banner.empty{background-image:repeating-linear-gradient(135deg,transparent 0 16px,color-mix(in srgb,var(--acc) 14%,transparent) 16px 17px)}
.bbtn{position:absolute;right:10px;top:10px;display:flex;align-items:center;gap:6px;font-size:12.5px;padding:6px 10px;border-radius:8px;background:rgba(0,0,0,.45);color:#fff;cursor:pointer}
.herobody{display:flex;gap:16px;align-items:flex-end;flex-wrap:wrap;padding:0 18px 18px}
.avatar{position:relative;width:104px;height:104px;margin-top:-52px;border-radius:20px;border:3px solid var(--acc);background:var(--card);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:2px;overflow:hidden;cursor:pointer;color:var(--acc);font-size:11.5px;flex-shrink:0}
.avatar img{width:100%;height:100%;object-fit:cover}
.who{flex:1;min-width:200px;display:flex;flex-direction:column;gap:2px}
.hin{background:transparent;border:0;border-bottom:1px dashed transparent;padding:2px 0;width:100%;outline:none}
.hin:hover,.hin:placeholder-shown{border-bottom-color:var(--line)}
.hin:focus{border-bottom:1px solid var(--acc)}
.nm{font-family:var(--fh);font-size:clamp(24px,4vw,34px);font-weight:700;line-height:1.15}
[data-font=hand] .nm{font-size:clamp(32px,5vw,46px)}
[data-font=pixel] .nm{font-size:clamp(18px,3vw,24px);font-weight:400}
.ttl{font-size:15px;color:var(--dim)}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;min-height:4px}
.chip{font-size:12px;padding:3px 9px;border-radius:6px;border:1px solid var(--line);color:var(--dim)}
.chip.h{background:var(--acc2);color:var(--on2);border-color:var(--acc2)}
.chip.a{border-color:var(--acc);color:var(--acc)}
button.chip.on{background:var(--acc2);border-color:var(--acc2);color:var(--on2)}
.lv{min-width:190px;flex:0 1 230px}
.lvn{font-family:var(--fh);font-weight:700;font-size:20px;color:var(--acc);display:flex;justify-content:space-between;align-items:baseline}
.lvn small{font-family:var(--fb);font-weight:400;font-size:12px;color:var(--faint)}
.bar{height:7px;border-radius:4px;background:var(--line);margin-top:6px;overflow:hidden}
.bar b{display:block;height:100%;background:var(--acc);border-radius:4px;transition:width .4s}

.spot{margin-top:14px;display:flex;gap:16px;border:1.5px solid var(--acc)}
.spotimg{position:relative;width:112px;aspect-ratio:2/3;flex-shrink:0;border-radius:10px;border:1.5px dashed var(--acc);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:4px;color:var(--acc);font-size:11.5px;overflow:hidden;cursor:pointer;max-width:100%}
.spotimg.has{border-style:solid}
.spotimg img{width:100%;height:100%;object-fit:cover}
.spotbody{flex:1;min-width:0;display:flex;flex-direction:column;gap:8px}
.eyebrow{display:flex;align-items:center;gap:6px;font-family:var(--fh);font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--acc);font-weight:600}
[data-font=hand] .eyebrow{text-transform:none;font-size:20px;letter-spacing:0}
.big{font-family:var(--fh);font-size:22px;font-weight:600}
[data-font=hand] .big{font-size:28px}
.row2{display:flex;gap:12px;flex-wrap:wrap}
.row2>*{flex:1;min-width:140px}
.spotact{display:flex;gap:8px;flex-wrap:wrap;margin-top:2px}
.hist{margin-top:12px;border-top:1px solid var(--line);padding-top:10px;display:flex;flex-direction:column;gap:6px}
.hrow{display:flex;align-items:center;gap:10px;font-size:13.5px}
.hrow .th{width:30px;height:42px}
.hrow .rt{flex:1;min-width:0}
.hrow small{display:block;color:var(--faint);font-size:12px}
@media (max-width:520px){.spot{flex-direction:column}.spotimg{width:100%;aspect-ratio:16/9}}

.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 16px}
.fields.mt{margin-top:16px}
.fld{display:flex;flex-direction:column;gap:1px;min-width:0}
.fld.wide{grid-column:1/-1}
.fld>label{font-size:11.5px;color:var(--dim);letter-spacing:.02em;display:flex;align-items:center;gap:6px}
.auto{font-size:10.5px;padding:0 6px;border-radius:4px;background:var(--acc2);color:var(--on2);letter-spacing:.03em}
.fld input:not([type=color]):not([type=file]),.fld select,.fld textarea,.tli textarea{background:transparent;border:0;border-bottom:1px dashed var(--line);border-radius:0;padding:5px 0;width:100%;font-size:14.5px;outline:none;min-width:0}
.fld input:focus,.fld select:focus,.fld textarea:focus,.tli textarea:focus{border-bottom:1px solid var(--acc)}
.fld select{appearance:none;-webkit-appearance:none;cursor:pointer;background-image:linear-gradient(45deg,transparent 50%,var(--faint) 50%),linear-gradient(135deg,var(--faint) 50%,transparent 50%);background-position:calc(100% - 9px) 55%,calc(100% - 4px) 55%;background-size:5px 5px;background-repeat:no-repeat;padding-right:18px}
.fld select option{background:var(--card);color:var(--ink)}
textarea{resize:none;field-sizing:content;min-height:2.3em;line-height:1.45}
.colrow{display:flex;align-items:center;gap:8px}
.sw,.sacc{position:relative;width:22px;height:22px;border-radius:50%;flex-shrink:0;border:1.5px solid var(--line);overflow:hidden;cursor:pointer}
.sw.empty,.sacc.empty{border-style:dashed;border-color:var(--faint)}
.sw input,.sacc input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}
.imgslot{position:relative;display:flex;align-items:center;justify-content:center;gap:6px;flex-direction:column;height:150px;border-radius:10px;border:1.5px dashed var(--line);color:var(--faint);font-size:12.5px;cursor:pointer;overflow:hidden;margin-top:4px}
.imgslot.has{border-style:solid}
.imgslot img{width:100%;height:100%;object-fit:cover}
.imgwrap{position:relative}
.imgwrap .x{position:absolute;right:6px;top:10px}

.lh{display:flex;align-items:center;gap:8px;margin:16px 0 9px;font-size:12.5px;color:var(--faint);flex-wrap:wrap}
.body>.lh:first-child,.lh.first{margin-top:0}
.bdg{font-size:11.5px;padding:2px 8px;border-radius:5px;font-weight:500;letter-spacing:.02em}
.bdg.now{background:var(--acc2);color:var(--on2)}
.bdg.all{border:1px solid var(--acc);color:var(--acc)}
.bdg.plain{border:1px solid var(--line);color:var(--dim)}
.grid{display:grid;gap:9px}
.grid.poster{grid-template-columns:repeat(auto-fill,minmax(70px,1fr))}
.grid.square{grid-template-columns:repeat(auto-fill,minmax(88px,1fr))}
.grid.round{grid-template-columns:repeat(auto-fill,minmax(66px,1fr))}
.pc{display:flex;flex-direction:column;gap:5px;min-width:0;text-align:left}
.pi{position:relative;display:flex;align-items:center;justify-content:center;width:100%;max-width:100%;border-radius:8px;overflow:hidden;background:color-mix(in srgb,var(--acc2) 55%,var(--card));color:var(--on2)}
.poster .pi{aspect-ratio:2/3}
.square .pi{aspect-ratio:1;border-radius:10px}
.round .pi{aspect-ratio:1;border-radius:50%}
.pi img{width:100%;height:100%;object-fit:cover;display:block}
.ini{font-family:var(--fh);font-weight:700;font-size:18px;opacity:.9}
.cap{font-size:12px;color:var(--dim);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.round .cap{text-align:center}
.pc:hover .pi{outline:2px solid color-mix(in srgb,var(--acc) 60%,transparent)}
.pc.first .pi{outline:2px solid var(--acc);outline-offset:-2px}
.rk{position:absolute;left:4px;top:4px;font-family:var(--fh);font-weight:700;font-size:11.5px;padding:1px 5px;border-radius:5px;background:rgba(0,0,0,.62);color:var(--acc)}
.pc.add .pi,.pc.ghost .pi{background:transparent;border:1.5px dashed var(--line);color:var(--faint)}
.pc.add:hover .pi{border-color:var(--acc);color:var(--acc);outline:none}
.pc.ghost{pointer-events:none;opacity:.45}
.rows{display:flex;flex-direction:column}
.rowi{display:flex;align-items:center;gap:6px;border-bottom:1px solid var(--line)}
.rowmain{flex:1;min-width:0;display:flex;align-items:center;gap:10px;padding:7px 0;text-align:left}
.th{width:38px;height:38px;border-radius:9px;overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:color-mix(in srgb,var(--acc2) 55%,var(--card));color:var(--on2)}
.th img{width:100%;height:100%;object-fit:cover}
.rt{flex:1;min-width:0;display:flex;flex-direction:column}
.rt b{font-weight:500;font-size:14.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rt small{font-size:12.5px;color:var(--faint);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tag{font-size:11.5px;padding:2px 8px;border-radius:5px;border:1px solid var(--acc);color:var(--acc);white-space:nowrap}
.lnk{color:var(--faint);padding:6px;display:flex}
.lnk:hover{color:var(--acc)}
.addrow{display:flex;align-items:center;justify-content:center;gap:6px;margin-top:9px;padding:7px;border-radius:9px;border:1.5px dashed var(--line);color:var(--faint);font-size:13px;width:100%}
.addrow:hover{border-color:var(--acc);color:var(--acc)}
.fchips{display:flex;gap:5px;margin:0 0 6px}
.tl{display:flex;flex-direction:column;gap:2px}
.tli{display:flex;align-items:flex-start;gap:8px}
.tli .dot{width:6px;height:6px;border-radius:50%;background:var(--acc);margin-top:14px;flex-shrink:0}
.tli .ck{color:var(--acc);margin-top:5px}
.tli.done textarea{text-decoration:line-through;color:var(--faint)}
.x{color:var(--faint);padding:4px;border-radius:6px;display:flex;margin-top:3px}
.x:hover{color:var(--ink);background:var(--line)}
.x .ms{font-size:16px}
.empty-note{font-size:13.5px;color:var(--faint);margin:0 0 4px}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;font-size:13.5px;padding:8px 14px;border-radius:9px;border:1px solid var(--line);color:var(--ink);background:transparent;cursor:pointer;white-space:nowrap}
.btn:hover{border-color:var(--acc)}
.btn .ms{font-size:17px}
.btn.pri{background:var(--acc);color:var(--onacc);border-color:var(--acc);font-weight:500}
.btn.pri:hover{filter:brightness(1.07)}
.btn.danger{color:#F0877C;border-color:color-mix(in srgb,#E24B4A 45%,transparent)}
.btn.armed,.ib.armed{background:#C03A3A;color:#fff;border-color:#C03A3A}
.btn.sm{padding:5px 10px;font-size:12.5px}
.btn:disabled{opacity:.4;cursor:default}
.ib{width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;border-radius:8px;color:var(--dim)}
.ib:hover:not(:disabled){background:var(--line);color:var(--ink)}
.ib:disabled{opacity:.3;cursor:default}

.entries{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px;margin-top:14px}
.entry{text-align:left;display:flex;flex-direction:column;gap:6px;overflow:hidden;padding:0 !important}
.entry:hover{border-color:var(--acc)}
.eimg{width:100%;aspect-ratio:16/9;object-fit:cover;display:block}
.einner{padding:12px 16px 16px;display:flex;flex-direction:column;gap:6px}
.emeta{display:flex;justify-content:space-between;font-size:12px;color:var(--faint);font-variant-numeric:tabular-nums}
.fileno{font-family:var(--fh);color:var(--acc);letter-spacing:.06em}
.entry h3{margin:0;font-family:var(--fh);font-size:18px;font-weight:600;line-height:1.25}
[data-font=hand] .entry h3{font-size:25px}
.entry p{margin:0;font-size:14px;color:var(--dim);display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
[data-font=hand] .entry p,[data-font=hand] .etext{font-family:'Caveat',cursive;font-size:20px;line-height:1.3}
.moodc{align-self:flex-start;font-size:12px;padding:2px 9px;border-radius:6px;background:color-mix(in srgb,var(--mc) 22%,transparent);color:color-mix(in srgb,var(--mc) 70%,var(--ink));border:1px solid color-mix(in srgb,var(--mc) 50%,transparent)}
.moods{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
.mood{font-size:13px;padding:5px 11px;border-radius:8px;border:1px solid var(--line);color:var(--dim)}
.mood.on{background:color-mix(in srgb,var(--mc) 25%,transparent);border-color:var(--mc);color:var(--ink)}
.ephotos{display:grid;grid-template-columns:repeat(auto-fill,minmax(90px,1fr));gap:8px;margin-top:6px}
.ep{position:relative;aspect-ratio:1;border-radius:9px;overflow:hidden}
.ep img{width:100%;height:100%;object-fit:cover}
.ep .x{position:absolute;right:4px;top:4px;margin:0;background:rgba(0,0,0,.55);color:#fff}
.ep.add{display:flex;align-items:center;justify-content:center;border:1.5px dashed var(--line);color:var(--faint);cursor:pointer}
.ep.add:hover{border-color:var(--acc);color:var(--acc)}
.emptyp{text-align:center;padding:40px 20px !important;margin-top:14px;display:flex;flex-direction:column;align-items:center;gap:8px}
.emptyp .ms{font-size:36px;color:var(--acc)}
.emptyp h2{margin:0;font-family:var(--fh);font-size:20px}
.emptyp p{margin:0 0 8px;color:var(--dim);max-width:44ch}
.latest{display:flex;gap:12px;text-align:left;width:100%}
.latest img{width:74px;height:74px;border-radius:9px;object-fit:cover;flex-shrink:0}
.latest .rt b{white-space:normal}

.cz{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:14px;margin-top:14px;align-items:start}
.themes{display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:10px}
.thm{display:flex;flex-direction:column;gap:6px;font-size:12.5px;color:var(--dim);text-align:left}
.tprev{display:block;height:64px;border-radius:10px;background:var(--tb);border:2px solid var(--line);padding:8px;position:relative}
.tprev i{display:block;border-radius:4px}
.tprev i:nth-child(1){height:14px;background:var(--t2)}
.tprev i:nth-child(2){height:18px;margin-top:6px;background:var(--tc);width:70%}
.tprev i:nth-child(3){position:absolute;right:8px;bottom:8px;width:14px;height:14px;border-radius:50%;background:var(--ta)}
.thm.on .tprev{border-color:var(--acc)}
.thm.on{color:var(--ink)}
.custcols{display:flex;flex-wrap:wrap;gap:12px;margin-top:14px}
.cc{display:flex;align-items:center;gap:7px;font-size:13px;color:var(--dim);cursor:pointer}
.cc input{width:30px;height:30px;border:1px solid var(--line);border-radius:8px;padding:0;background:none;cursor:pointer}
.note{font-size:12.5px;color:var(--faint);margin:8px 0 0}
.tog{display:flex;align-items:center;gap:10px;margin-top:14px;font-size:14px;cursor:pointer}
.tog input{width:18px;height:18px;accent-color:var(--acc)}
.optg{margin-bottom:14px}
.optg>span{display:block;font-size:12px;color:var(--dim);margin-bottom:6px}
.opts{display:flex;flex-wrap:wrap;gap:6px}
.opts .chip{font-size:13px;padding:6px 12px}
.srow{display:flex;align-items:center;gap:4px;padding:4px 0;border-bottom:1px solid var(--line)}
.srow.off .sname{color:var(--faint);text-decoration:line-through}
.sname{flex:1;min-width:0;background:transparent;border:0;border-bottom:1px dashed transparent;padding:4px 2px;font-size:14px;outline:none}
.sname:focus,.sname:hover{border-bottom-color:var(--line)}
.sgrp{font-size:12px;color:var(--dim);margin:14px 0 4px;letter-spacing:.04em}
.sgrp:first-of-type{margin-top:0}
.newsec{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 16px}
.bk{width:100%;height:120px;font-family:ui-monospace,monospace;font-size:11.5px;background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:8px;color:var(--dim);resize:vertical;field-sizing:fixed}
