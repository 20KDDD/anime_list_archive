 <p class="err" id="merr"></p>
 <div class="mact">${orig?'<button class="btn danger" id="mdel">Delete</button>':''}${orig&&idx>0?`<button class="btn" id="mup">${L.rank?'Rank up':'Move earlier'}</button>`:''}${orig&&idx<arr.length-1?`<button class="btn" id="mdn">${L.rank?'Rank down':'Move later'}</button>`:''}${orig&&target?`<button class="btn" id="mpro"><span class="ms">star</span>Move to ${esc(target.l.toLowerCase())}</button>`:''}<span class="sp"></span><button class="btn" data-close>Cancel</button><button class="btn pri" id="msave">Save</button></div>`);
