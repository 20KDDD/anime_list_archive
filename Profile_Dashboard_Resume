 if(page==='about')m.innerHTML=heroHTML()+obHTML()+board('about');
 else if(page==='favs')m.innerHTML=`<div class="pagehead"><div><h1>Favorites</h1><p>What you're into right now, and your all-time favorites.</p></div></div>`+board('favs');
 else if(page==='diary')m.innerHTML=diaryHTML();else m.innerHTML=customizeHTML()}
