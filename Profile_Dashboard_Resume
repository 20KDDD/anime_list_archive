let saveT;
function save(){clearTimeout(saveT);saveT=setTimeout(async()=>{try{const db=await idb();await new Promise((res,rej)=>{const t=db.transaction('kv','readwrite');t.objectStore('kv').put(S,'state');t.oncomplete=res;t.onerror=()=>rej(t.error);t.onabort=()=>rej(t.error)});canSave=true;setStatus('Saved')}catch(e){canSave=false;setStatus()}},350)}
