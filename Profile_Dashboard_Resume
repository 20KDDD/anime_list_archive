function secHTML(id){const d=def(id);if(!d)return '';const acc=S.layout.accent[id];const t=S.layout.titles[id]||d.t;
 return `<section class="sec" id="s-${id}" ${acc?`style="--sa:${esc(acc)}"`:''}><h2 class="sh"><span class="ms">${d.i}</span>${esc(t)}</h2>${d.hint?`<p class="hint">${esc(d.hint)}</p>`:''}<div class="body">${bodyHTML(id,d)}</div></section>`}
function bodyHTML(id,d){switch(d.type){
 case 'fields':return fieldsHTML(id,d.fields);
 case 'stars':{const a=autoStars();return `<div class="fields">${d.fields.map(f=>fieldHTML(id,f,f.k in a?a[f.k]:undefined)).join('')}</div><p class="note">Fill in your birthday and the auto fields fill in. Moon and rising need your birth time and place.</p>`}
 case 'lists':return d.lists.map((L,i)=>listHTML(id,d,L,i)).join('')+(d.fields?fieldsHTML(id,d.fields,'mt'):'');
 case 'text':return textHTML(id,d,false);
 case 'check':return textHTML(id,d,true);
 case 'latest':return latestHTML()}return ''}
function fieldsHTML(s,fields,cls=''){return `<div class="fields ${cls}">${fields.map(f=>fieldHTML(s,f)).join('')}</div>`}
function fieldHTML(s,f,autoVal){const v=fv(s,f.k),id=`f-${s}-${f.k}`,dk=`${s}.${f.k}`,ph=esc(f.ph||'—');let c;
 if(f.type==='select')c=`<select id="${id}" data-f="${dk}">${f.opts.map(o=>`<option value="${esc(o)}"${o===v?' selected':''}>${o?esc(o):'—'}</option>`).join('')}</select>`;
 else if(f.type==='date')c=`<input type="date" id="${id}" data-f="${dk}" value="${esc(v)}">`;
 else if(f.type==='long')c=`<textarea id="${id}" data-f="${dk}" rows="2" placeholder="${ph}">${esc(v)}</textarea>`;
 else if(f.type==='color'){const hx=fv(s,f.k+'_hex');c=`<div class="colrow"><label class="sw${hx?'':' empty'}" ${hx?`style="background:${esc(hx)}"`:''} title="Pick the color"><input type="color" data-f="${s}.${f.k}_hex" value="${esc(hx||'#1a6b45')}" aria-label="Pick the color"></label><input id="${id}" data-f="${dk}" value="${esc(v)}" placeholder="${ph}"></div>`}
 else if(f.type==='image')return `<div class="fld wide imgwrap"><label class="imgslot${v?' has':''}">${v?`<img src="${esc(v)}" alt="">`:'<span class="ms">add_photo_alternate</span><span>Add an image</span>'}<input type="file" accept="image/*" hidden data-up="f:${dk}"></label>${v?`<button class="x" data-clr="${dk}" aria-label="Remove image" style="background:rgba(0,0,0,.55);color:#fff"><span class="ms">close</span></button>`:''}</div>`;
 else{const shown=v||autoVal||'';c=`<input id="${id}" data-f="${dk}" value="${esc(shown)}" placeholder="${ph}"${autoVal!==undefined?` data-auto="${esc(autoVal)}"`:''}>`}
 return `<div class="fld${f.wide?' wide':''}"><label for="${id}">${esc(f.l)}${autoVal&&!v?'<span class="auto">auto</span>':''}</label>${c}</div>`}
function listHTML(id,d,L,i){const items=getList(id,L.k);let head='';
 if(L.l)head=`<div class="lh${i===0?' first':''}"><span class="bdg ${L.b||'plain'}">${esc(L.l)}</span>${L.rank?'<span>Ranked, #1 first</span>':''}${L.to?'<span>Tap one to move it to all-time</span>':''}</div>`;
 let list=items;if(L.filter){const cur=filt[id]||'All';head+=`<div class="fchips">${['All',...L.filter].map(x=>`<button class="chip${x===cur?' on':''}" data-filt="${id}.${x}">${x}</button>`).join('')}</div>`;if(cur!=='All')list=items.filter(it=>(it.tag||'Esports')===cur)}
 const ref=it=>`${id}.${L.k}.${it.id}`;
 if(L.shape==='row')return head+`<div class="rows">${list.map(it=>`<div class="rowi"><button class="rowmain" data-edit="${ref(it)}"><span class="th">${it.img?`<img src="${esc(it.img)}" alt="">`:`<span class="ms">${d.i}</span>`}</span><span class="rt"><b>${esc(it.title)}</b>${it.sub?`<small>${esc(it.sub)}</small>`:''}</span>${it.tag?`<span class="tag">${esc(it.tag)}</span>`:''}</button>${it.link?`<a class="lnk" href="${esc(it.link)}" target="_blank" rel="noopener" aria-label="Open link"><span class="ms">open_in_new</span></a>`:''}</div>`).join('')}</div><button class="addrow" data-add="${id}.${L.k}"><span class="ms">add</span>Add ${esc(L.noun||d.noun||'')}</button>`;
 const ghosts=Math.max(0,(L.shape==='poster'?4:3)-list.length-1);
 return head+`<div class="grid ${L.shape}">${list.map((it,n)=>`<button class="pc${L.rank&&n===0?' first':''}" data-edit="${ref(it)}" title="${esc(it.title)}"><span class="pi">${it.img?`<img src="${esc(it.img)}" alt="" loading="lazy">`:`<span class="ini">${esc(initials(it.title))}</span>`}${L.rank?`<span class="rk">#${n+1}</span>`:''}</span><span class="cap">${esc(it.title)}</span></button>`).join('')}<button class="pc add" data-add="${id}.${L.k}" aria-label="Add ${esc(L.noun||d.noun||'')}"><span class="pi"><span class="ms">add</span></span><span class="cap">&nbsp;</span></button>${'<span class="pc ghost"><span class="pi"></span></span>'.repeat(ghosts)}</div>`}
function textHTML(id,d,check){const items=getList(id,'items');return `<div class="tl">${items.map(it=>`<div class="tli${it.done?' done':''}">${check?`<button class="ck" data-ck="${id}.${it.id}" aria-label="Mark done"><span class="ms">${it.done?'check_box':'check_box_outline_blank'}</span></button>`:'<span class="dot"></span>'}<textarea rows="1" data-tl="${id}.${it.id}" placeholder="${esc(d.ph)}" aria-label="${esc(d.t)}">${esc(it.text)}</textarea><button class="x" data-tldel="${id}.${it.id}" aria-label="Remove"><span class="ms">close</span></button></div>`).join('')}</div><button class="addrow" data-tladd="${id}"><span class="ms">add</span>${check?'Add quest':'Add'}</button>`}
function latestHTML(){const e=[...S.diary].sort(sortEntries)[0];if(!e)return `<p class="empty-note">No save files yet.</p><button class="addrow" data-act="newentry"><span class="ms">edit</span>Write your first entry</button>`;
 const m=MOODS.find(x=>x[0]===e.mood);return `<button class="latest" data-entry="${e.id}">${e.photos?.[0]?`<img src="${esc(e.photos[0])}" alt="">`:''}<span class="rt"><small>${fmtDate(e.date)}</small><b>${esc(e.title||'Untitled')}</b><small>${esc((e.text||'').slice(0,90))}</small></span></button>${m?`<span class="moodc" style="--mc:${m[1]};display:inline-block;margin-top:8px">${cap(m[0])}</span>`:''}`}

/* hero + obsession */
function chipsHTML(){const p=S.f.persona||{},out=[];if(p.house)out.push(`<span class="chip h">${esc(p.house)}</span>`);if(p.mbti)out.push(`<span class="chip a">${esc(p.mbti)}</span>`);if(p.ennea)out.push(`<span class="chip a">${esc(p.ennea)}</span>`);const sg=starVal('sign');if(sg)out.push(`<span class="chip">${esc(sg)}</span>`);const el=starVal('element');if(el)out.push(`<span class="chip">${esc(el)}</span>`);return out.join('')}
