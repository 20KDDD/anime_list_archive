<style>
:root{
  --bg:#EDEFE8; --surface:#FAFBF6; --surface-2:#E3E6DD; --ink:#171A28; --muted:#5B6070; --line:#CFD3C8;
  --accent:#D3305A; --accent-ink:#FFFFFF; --accent-soft:#F7D9E1;
  --st-watching:#23805A; --st-completed:#2C5FB3; --st-on_hold:#B07D12; --st-dropped:#A83246; --st-plan:#6A6E7C;
  --shadow:0 1px 0 rgba(23,26,40,.06),0 6px 18px -10px rgba(23,26,40,.25);
  --display:"Dela Gothic One","Arial Black",Impact,sans-serif;
  --body:"Zen Kaku Gothic New",system-ui,-apple-system,"Segoe UI",sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  color-scheme:dark;
  --bg:#11131B; --surface:#1A1D28; --surface-2:#232736; --ink:#ECEEF4; --muted:#9BA1B4; --line:#2E3345;
  --accent:#FF5C82; --accent-ink:#1A0B10; --accent-soft:#3A1B26;
  --st-watching:#4CC38E; --st-completed:#6F9BF0; --st-on_hold:#E0AE45; --st-dropped:#F07086; --st-plan:#A0A5B5;
  --shadow:0 1px 0 rgba(0,0,0,.3),0 8px 22px -12px rgba(0,0,0,.7);
}}
:root[data-theme="dark"]{
  color-scheme:dark;
  --bg:#11131B; --surface:#1A1D28; --surface-2:#232736; --ink:#ECEEF4; --muted:#9BA1B4; --line:#2E3345;
  --accent:#FF5C82; --accent-ink:#1A0B10; --accent-soft:#3A1B26;
  --st-watching:#4CC38E; --st-completed:#6F9BF0; --st-on_hold:#E0AE45; --st-dropped:#F07086; --st-plan:#A0A5B5;
  --shadow:0 1px 0 rgba(0,0,0,.3),0 8px 22px -12px rgba(0,0,0,.7);
}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--body);font-size:15px;line-height:1.5;padding-inline:16px;padding-block:0 64px}
.wrap{max-width:1180px;margin:0 auto}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
h1,h2,h3{text-wrap:balance;margin:0}
.mono{font-family:var(--mono);font-variant-numeric:tabular-nums}

/* header */
header.top{display:flex;flex-wrap:wrap;align-items:center;gap:12px 16px;padding-block:22px 14px}
.brand{display:flex;align-items:baseline;gap:10px;margin-right:auto}
.brand h1{font-family:var(--display);font-weight:400;font-size:clamp(26px,5vw,36px);letter-spacing:.01em;line-height:1}
.brand .perf{display:inline-flex;gap:3px;transform:translateY(-4px)}
.brand .perf i{width:7px;height:10px;border-radius:2px;background:var(--accent)}
.brand .perf i:nth-child(2){opacity:.6}.brand .perf i:nth-child(3){opacity:.3}
.sync{font-family:var(--mono);font-size:11.5px;color:var(--muted);letter-spacing:.02em;display:flex;align-items:center;gap:6px}
.sync::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--muted)}
.sync.ok::before{background:var(--st-watching)}
.sync.local::before{background:var(--st-on_hold)}
.actions{display:flex;flex-wrap:wrap;gap:8px}
.btn{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:var(--surface);border-radius:10px;padding:8px 14px;font-weight:500;font-size:14px}
.btn:hover{border-color:var(--muted)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink);font-weight:700}
.btn.primary:hover{filter:brightness(1.05)}
.btn.ghost{background:transparent}
.btn.danger{color:var(--st-dropped);border-color:color-mix(in srgb,var(--st-dropped) 45%,var(--line))}
.btn.danger.armed{background:var(--st-dropped);color:#fff;border-color:var(--st-dropped)}
.btn:disabled{opacity:.5;cursor:not-allowed}
.btn.sm{padding:5px 10px;font-size:13px;border-radius:8px}

/* stats band */
.band{display:grid;grid-template-columns:repeat(4,minmax(0,1fr)) minmax(0,1.6fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:14px;overflow:hidden;margin-bottom:18px}
.stat{background:var(--surface);padding:14px 16px;display:flex;flex-direction:column;gap:2px;min-width:0}
.stat .k{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:700}
.stat .v{font-family:var(--display);font-size:28px;line-height:1.15;font-variant-numeric:tabular-nums}
.stat .s{font-size:12px;color:var(--muted)}
.hist{background:var(--surface);padding:12px 16px 10px;display:flex;flex-direction:column;gap:6px;min-width:0}
.hist .bars{display:grid;grid-template-columns:repeat(10,1fr);gap:4px;align-items:end;height:74px}
.hist .bar{display:flex;flex-direction:column;justify-content:flex-end;align-items:center;height:100%;gap:2px}
